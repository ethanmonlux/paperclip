{
  "version": 1,
  "about": "Staple PR CI scope (STA-223). Read by .github/scripts/staple-ci-scope.mjs in the fork's routing step, on pull_request only. PRs run build, typecheck, policy and the suites that cover the changed paths; the nightly staple-certify.yml run keeps the complete suite, and the installer installs only commits it certified. Held by .github/scripts/tests/staple-ci-scope.test.mjs.",
  "fullSuiteBranches": ["staple/upstream-sync-*"],
  "policyOnlyPaths": [
    "scripts/staple/**",
    "scripts/__tests__/staple-*.test.mjs",
    "scripts/__tests__/fixtures/staple-*/**",
    ".github/staple-ci-scope.json",
    ".github/scripts/staple-ci-scope.mjs",
    ".github/scripts/tests/staple-ci-scope.test.mjs",
    ".github/scripts/tests/staple-certify-workflow.test.mjs",
    ".github/workflows/staple-certify.yml"
  ],
  "pathSets": {
    "lifecycle": [
      "server/src/services/heartbeat/**",
      "server/src/services/heartbeat*",
      "server/src/services/agent-lifecycle*",
      "server/src/services/agent-execution*",
      "server/src/services/agent-start*",
      "server/src/services/agent-run*",
      "server/src/services/agents.ts",
      "server/src/services/issues.ts",
      "server/src/services/issue-assignment*",
      "server/src/services/*routing*",
      "server/src/services/access.ts",
      "server/src/services/recovery/**",
      "server/src/services/native-runtime/**",
      "server/src/services/wake*",
      "server/src/modules/wake-queue/**",
      "server/src/agent-run-cancellation.ts",
      "server/src/index.ts",
      "server/src/app.ts",
      "server/src/routes/**",
      "server/src/middleware/**",
      "server/src/auth/**",
      "server/src/realtime/**",
      "packages/shared/src/api.ts",
      "packages/shared/src/validators/**",
      "packages/db/**",
      "packages/adapter-utils/**",
      "packages/adapters/**",
      "ui/src/api/**"
    ],
    "chat": [
      "server/src/services/chat*",
      "server/src/services/chat-channels/**",
      "server/src/services/*-chat-*",
      "server/src/services/native-chat*",
      "server/src/__tests__/chat-channels*",
      "server/src/__tests__/helpers/**",
      "server/src/routes/*chat*",
      "packages/shared/src/*chat*"
    ],
    "runner": [
      "packages/paperclip-runner/**",
      "server/src/services/native-runtime/**",
      "server/src/services/agent-runner*",
      "server/src/services/*runner*",
      "server/src/vendor/**",
      "server/src/dev-native-runner-status.ts",
      "server/src/dev-runner-worktree.ts"
    ],
    "docker": [
      "Dockerfile*",
      "**/Dockerfile*",
      ".dockerignore",
      "**/.dockerignore",
      "docker/**"
    ],
    "release": [
      "cli/**",
      "server/src/version.ts",
      "server/src/build-*.ts",
      "server/src/startup-*.ts",
      "releases/**"
    ]
  },
  "jobs": {
    "typecheck_release_registry": "always",
    "build": "always",
    "general_tests": { "groups": { "general-chat": ["lifecycle", "chat"] } },
    "verify_serialized_server": "plan",
    "sandbox_provider_tests": "plan",
    "e2e_shards": ["lifecycle"],
    "verify_paperclip_runner": ["runner"],
    "verify_runner_e2e_support": ["runner"],
    "docker_context_integrity": ["docker"],
    "canary_dry_run": ["release"]
  },
  "packages": {
    "cli": ["release"],
    "server": [],
    "ui": [],
    "packages/adapter-utils": ["lifecycle"],
    "packages/adapters/claude-local": ["lifecycle"],
    "packages/adapters/codex-local": ["lifecycle"],
    "packages/adapters/cursor-cloud": ["lifecycle"],
    "packages/adapters/cursor-local": ["lifecycle"],
    "packages/adapters/gemini-local": ["lifecycle"],
    "packages/adapters/grok-local": ["lifecycle"],
    "packages/adapters/hermes": ["lifecycle"],
    "packages/adapters/hermes-gateway": ["lifecycle"],
    "packages/adapters/kimi-local": ["lifecycle"],
    "packages/adapters/openclaw-gateway": ["lifecycle"],
    "packages/adapters/opencode-local": ["lifecycle"],
    "packages/adapters/pi-local": ["lifecycle"],
    "packages/db": ["lifecycle"],
    "packages/google-sheets-mcp-server": [],
    "packages/kv-demo-mcp-server": [],
    "packages/mcp-server": [],
    "packages/paperclip-eval-kernel": [],
    "packages/paperclip-runner": ["runner"],
    "packages/plugins/create-paperclip-plugin": [],
    "packages/plugins/examples/*": [],
    "packages/plugins/paperclip-plugin-fake-sandbox": [],
    "packages/plugins/plugin-llm-wiki": [],
    "packages/plugins/plugin-workspace-diff": [],
    "packages/plugins/sandbox-providers/*": [],
    "packages/plugins/sdk": [],
    "packages/shared": [],
    "packages/skills-catalog": [],
    "packages/tailscale-https-broker": [],
    "packages/teams-catalog": []
  }
}
