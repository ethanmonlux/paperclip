{
  "version": 2,
  "about": "Staple CI scope (STA-223). Read by .github/scripts/staple-ci-scope.mjs in the fork's routing step, on pull_request only. A routine push runs policy, a typecheck of the packages the change affects, and the focused regression tests whose import graph reaches the change. Suites marked \"certification\" never run on a routine push: the nightly staple-certify.yml run builds one merged master commit and runs the complete suite, and the installer installs only a commit it certified. The full-ci label runs the complete suite on one pull request. Held by .github/scripts/tests/staple-ci-scope.test.mjs.",
  "policyOnlyPaths": [
    "scripts/staple/**",
    "scripts/__tests__/staple-*.test.mjs",
    "scripts/__tests__/fixtures/staple-*/**",
    ".github/staple-ci-scope.json",
    ".github/scripts/staple-ci-scope.mjs",
    ".github/scripts/tests/staple-ci-scope.test.mjs",
    ".github/scripts/tests/staple-certify-workflow.test.mjs",
    ".github/workflows/staple-certify.yml"
  ],
  "routine": {
    "maxTestJobs": 6,
    "testConfigPaths": ["vitest.config.*", "vitest.workspace.*"],
    "typecheckAllPaths": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      "tsconfig*.json",
      "patches/**",
      "scripts/run-tsc.mjs"
    ]
  },
  "pathSets": {
    "chat": [
      "server/src/services/chat*",
      "server/src/services/chat-channels/**",
      "server/src/services/*-chat-*",
      "server/src/services/native-chat*",
      "server/src/__tests__/chat-channels*",
      "server/src/__tests__/helpers/**",
      "server/src/routes/*chat*",
      "packages/shared/src/*chat*"
    ],
    "runner": ["packages/paperclip-runner/**"],
    "docker": [
      "Dockerfile*",
      "**/Dockerfile*",
      ".dockerignore",
      "**/.dockerignore",
      "docker/**"
    ]
  },
  "jobs": {
    "typecheck_release_registry": "certification",
    "build": "certification",
    "general_tests": {
      "groups": {
        "general-chat": ["chat"]
      }
    },
    "verify_serialized_server": "plan",
    "sandbox_provider_tests": "plan",
    "e2e_shards": "certification",
    "verify_paperclip_runner": ["runner"],
    "verify_runner_e2e_support": "certification",
    "docker_context_integrity": ["docker"],
    "canary_dry_run": "certification"
  },
  "packages": {
    "cli": [],
    "server": [],
    "ui": [],
    "packages/adapter-utils": [],
    "packages/adapters/claude-local": [],
    "packages/adapters/codex-local": [],
    "packages/adapters/cursor-cloud": [],
    "packages/adapters/cursor-local": [],
    "packages/adapters/gemini-local": [],
    "packages/adapters/grok-local": [],
    "packages/adapters/hermes": [],
    "packages/adapters/hermes-gateway": [],
    "packages/adapters/kimi-local": [],
    "packages/adapters/openclaw-gateway": [],
    "packages/adapters/opencode-local": [],
    "packages/adapters/pi-local": [],
    "packages/db": [],
    "packages/google-sheets-mcp-server": [],
    "packages/kv-demo-mcp-server": [],
    "packages/mcp-server": [],
    "packages/paperclip-eval-kernel": [],
    "packages/paperclip-runner": ["runner"],
    "packages/plugins/create-paperclip-plugin": [],
    "packages/plugins/examples/*": [],
    "packages/plugins/paperclip-plugin-fake-sandbox": [],
    "packages/plugins/plugin-llm-wiki": [],
    "packages/plugins/plugin-workspace-diff": [],
    "packages/plugins/sandbox-providers/*": [],
    "packages/plugins/sdk": [],
    "packages/shared": [],
    "packages/skills-catalog": [],
    "packages/tailscale-https-broker": [],
    "packages/teams-catalog": []
  }
}
